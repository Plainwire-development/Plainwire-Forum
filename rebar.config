{erl_opts, [debug_info]}.

{deps, [
    {cowboy, "2.12.0"},
    {jsx, "3.1.0"},
    {esqlite, "0.8.6"}
]}.

{relx, [
    {release, {plainwire_forum, "0.1.0"}, [plainwire_forum]},
    {dev_mode, true},
    {include_erts, false},
    {extended_start_script, true}
]}.

{profiles, [
    {prod, [
        {relx, [{dev_mode, false}, {include_erts, true}]}
    ]}
]}.
